<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- MSI Package for Quick Snap F8 -->
  <Package Name="F8" 
           Manufacturer="JessMichaelPad" 
           Version="1.0.3" 
           UpgradeCode="d7b3a9e2-4f8c-4b1a-9d2e-5c6b7a8d9e0f"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <!-- Kill running instance before update (Immediate action) -->
    <CustomAction Id="KillF8" 
                  Directory="TARGETDIR" 
                  ExeCommand="cmd.exe /c taskkill /f /im F8.exe /t" 
                  Return="ignore" />

    <!-- Auto-start after installation -->
    <CustomAction Id="LaunchApp" 
                  FileRef="F8EXE" 
                  ExeCommand="" 
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="KillF8" Before="InstallInitialize" Condition="1" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="F8" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <!-- Main Executable -->
      <Component Guid="a1b2c3d4-e5f6-4a5b-bc6d-7e8f9a0b1c2d">
        <File Id="F8EXE" Source="..\artifacts\F8.exe" KeyPath="yes">
          <Shortcut Id="DesktopShortcut" 
                    Directory="DesktopFolder" 
                    Name="F8" 
                    WorkingDirectory="INSTALLFOLDER" 
                    Advertise="no" 
                    Icon="AppIcon" />
          <Shortcut Id="StartMenuShortcut" 
                    Directory="ProgramMenuFolder" 
                    Name="F8" 
                    WorkingDirectory="INSTALLFOLDER" 
                    Advertise="no" 
                    Icon="AppIcon" />
        </File>
      </Component>

      <!-- Icon File -->
      <Component Guid="b2c3d4e5-f6a7-4b8c-9d0e-1a2b3c4d5e6f">
        <File Id="AppIco" Source="..\..\F8.ico" />
      </Component>

      <!-- Startup Launch -->
      <Component Guid="c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" 
                       Key="Software\Microsoft\Windows\CurrentVersion\Run" 
                       Name="F8" 
                       Value="[#F8EXE]" 
                       Type="string" 
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Icon Id="AppIcon" SourceFile="..\..\F8.ico" />
  </Fragment>
</Wix>
